# Copy to .env before `docker compose up`. Nothing in here is committed.

# Read-only GitHub token. Needs `public_repo` for public repositories and
# `repo` if any owner in skillHub.owners has private ones. Used for the org
# walk, the manifest read and rendering asset bodies.
GITHUB_TOKEN=

# Where the browser reaches the hub. Change this if you publish it somewhere
# other than the machine running Compose.
APP_BASE_URL=http://localhost:7007

# GitHub OAuth app, for real identity on the install receipt. Leave both blank
# to run on guest identity instead.
# Homepage URL:     the APP_BASE_URL above
# Callback URL:     ${APP_BASE_URL}/api/auth/github/handler/frame
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Optional receipt service. Leave blank to log copies locally instead of
# posting them. A DB-issued agent token with only the receipts scope.
RECEIPT_SERVICE_BASE_URL=
RECEIPT_SERVICE_TOKEN=

# Local Postgres, for the Compose stack only.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=backstage
